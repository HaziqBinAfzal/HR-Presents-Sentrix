# Sentrix application
SECRET_KEY=replace_with_a_long_random_secret
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# Database
DATABASE_URL=sqlite:///instance/database.db

# Uploads
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=uploads
SESSION_COOKIE_SECURE=0

# Sentrix-managed AI backend (never expose this key to end users)
OPENAI_API_KEY=
OPENAI_MODEL=

# Email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=supportsentrix@gmail.com
